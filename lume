#!/usr/bin/env bash
# Lume CLI 跨平台统一入口（Unix: Linux / macOS / BSD / Git Bash）。
# 所有实际逻辑在 lume_launcher.py，Windows 使用同目录的 lume.cmd / lume.ps1。
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
  SOURCE="$(readlink -- "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"

PYTHON="${LUME_LAUNCHER_PYTHON:-}"
if [[ -z "$PYTHON" ]]; then
  for CANDIDATE in \
    "$ROOT/.venv/bin/python" \
    "$HOME/.local/share/lume-repl-venv/bin/python" \
    python3 python; do
    if [[ "$CANDIDATE" == /* ]]; then
      [[ -x "$CANDIDATE" ]] && PYTHON="$CANDIDATE" && break
    elif command -v "$CANDIDATE" >/dev/null 2>&1; then
      PYTHON="$(command -v "$CANDIDATE")"
      break
    fi
  done
fi

if [[ -z "$PYTHON" ]]; then
  echo "[lume] Python 3 not found; install Python 3.10+ or set LUME_LAUNCHER_PYTHON." >&2
  exit 127
fi

# 清掉会污染解释器的环境变量（用户级 Python 常见坑）。
exec env -u PYTHONPATH -u LD_LIBRARY_PATH "$PYTHON" "$ROOT/lume_launcher.py" "$@"
