// 运算符重载：`a + b` 落到结构体上的 `op_*` 方法。
//
// 覆盖的能力：
//   1. 五个算术运算 + 一元取负
//   2. 六个比较运算 —— 这里**只定义了 op_lt 和 op_eq**，
//      `>` / `<=` / `>=` / `!=` 全靠编译器组合（换位 / 取反）
//   3. op_str：插值 `"{a}"`、`say(a)` 都自动转字符串
//   4. 左操作数没有地址时的临时变量路径：(a+b)+a、-(a+b)
//   5. 方法体里 `self + self` 和 `self.gcd(...)`

struct Frac {
    n: int
    d: int

    // 方法之间互相调用：`self.gcd(...)`（以前生成 C 的 self.gcd，clang 报错）
    fn gcd(a: int, b: int) -> int {
        x := int_abs(a)
        y := int_abs(b)
        while y != 0 {
            t := x % y
            x = y
            y = t
        }
        if x == 0 {
            return 1
        }
        return x
    }

    fn reduce() -> Frac {
        g := self.gcd(n, d)
        nn := n / g
        dd := d / g
        if dd < 0 {
            nn = -nn
            dd = -dd
        }
        return Frac(n: nn, d: dd)
    }

    fn op_neg() -> Frac {
        return Frac(n: -n, d: d)
    }

    fn op_str() -> str {
        if d == 1 {
            return int_to_str(n)
        }
        return int_to_str(n) + "/" + int_to_str(d)
    }

    // ── 算术（五个都显式定义）──
    fn op_add(o: Frac) -> Frac {
        r := Frac(n: n * o.d + o.n * d, d: d * o.d)
        return r.reduce()
    }

    fn op_sub(o: Frac) -> Frac {
        r := Frac(n: n * o.d - o.n * d, d: d * o.d)
        return r.reduce()
    }

    fn op_mul(o: Frac) -> Frac {
        r := Frac(n: n * o.n, d: d * o.d)
        return r.reduce()
    }

    fn op_div(o: Frac) -> Frac {
        r := Frac(n: n * o.d, d: d * o.n)
        return r.reduce()
    }

    // ── 比较（只写两个，其余让编译器推）──
    fn op_eq(o: Frac) -> bool {
        return n * o.d == o.n * d
    }

    fn op_lt(o: Frac) -> bool {
        return n * o.d < o.n * d
    }

    // 方法体里 self 直接参与运算
    fn twice() -> Frac {
        return self + self
    }
}

fn main() {
    a := Frac(n: 1, d: 3)
    b := Frac(n: 2, d: 5)

    say("===== 运算符重载 =====")
    say("[1] a = {a}   b = {b}   期望 1/3  2/5")
    say("[2] a + b = {a + b}   期望 11/15")
    say("[3] a - b = {a - b}   期望 -1/15")
    say("[4] a * b = {a * b}   期望 2/15")
    say("[5] a / b = {a / b}   期望 5/6")
    say("[6] -a = {-a}   期望 -1/3")

    say("===== 比较（只写了 op_eq / op_lt）=====")
    say("[7]  a == b = {a == b}   期望 0")
    say("[8]  a != b = {a != b}   期望 1")
    say("[9]  a <  b = {a < b}   期望 1")
    say("[10] a >  b = {a > b}   期望 0")
    say("[11] a <= b = {a <= b}   期望 1")
    say("[12] a >= b = {a >= b}   期望 0")

    say("===== 左操作数没有地址（临时变量路径）=====")
    say("[13] (a + b) + a = {(a + b) + a}   期望 16/15")
    say("[14] -(a + b) = {-(a + b)}   期望 -11/15")
    say("[15] a.twice() = {a.twice()}   期望 2/3")

    // say 直接传结构体：走 op_str，不是把第一个字段当整数打出来
    say("[16] say(a) 直接传 = ", a)
    c := Frac(n: 4, d: 6)
    say("[17] c.reduce() = {c.reduce()}   期望 2/3")

    // += 是 `a = a + b` 的语法糖，对结构体同样落到 op_add 上
    acc := Frac(n: 1, d: 2)
    acc += Frac(n: 1, d: 3)
    say("[18] acc += 1/3 → {acc}   期望 5/6")
}
