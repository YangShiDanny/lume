fn print_last_error() -> int
    message:any = ffi_buffer(256, 1)
    lume_net_last_error(message, 256)
    print(ffi_buffer_read_cstr(message, 0, 256))
ret 0

fn echo_client(client:int) -> int
    buffer:any = ffi_buffer(1024, 1)
    while true
        received:any = lume_net_recv(client, buffer, 1024, 1000)
        if received == 0
            ret 0
        end
        if received < 0
            print("recv failed")
            print_last_error()
            ret -1
        end
        message:any = ffi_buffer_read_cstr(buffer, 0, received + 1)
        sent:int = lume_net_send(client, message, received)
        if sent != received
            print("send failed")
            print_last_error()
            ret -1
        end
    end
ret 0

fn main() -> int
    server:any = lume_net_listen(18080)
    if server < 0
        print("listen failed")
        print_last_error()
        ret -1
    end

    deadline:int = mono_ms() + 5000
    while mono_ms() < deadline
        client:any = lume_net_accept(server, 500)
        if client >= 0
            echo_client(client)
            lume_net_close(client)
            deadline := mono_ms() + 5000
        end
    end
    lume_net_close(server)
ret 0
