// 大整数库的调用方。同目录的 big.lume 靠自动扫描并进来，没有 import。
//
//   lume run examples/bigint/main.lume
//
// 全部用运算符写：a + b / a * b / a / b / a % b / -a / a < b / "{a}"

fn main() {
    say("===== 构造与打印 =====")

    // 30! = 265252859812191058636308480000000
    say("[1] 30! = {big_fact(30)}")

    // 2^100 = 1267650600228229401496703205376
    two := big(2)
    say("[2] 2^100 = {two.pow(100)}")

    // 从字符串进来（远超 int64）
    n := big_str("123456789012345678901234567890")
    say("[3] 从字符串 = {n}")
    say("[4] n + 1 = {n + big(1)}")
    say("[5] -n = {-n}")

    // 大数相乘
    a := big_str("123456789012345678901")
    b := big_str("98765432109876543210")
    say("[6] a = {a}")
    say("[7] b = {b}")
    say("[8] a * b = {a * b}")

    say("===== 进位链 =====")
    say("[9] 999999999 + 1 = {big_str(\"999999999\") + big(1)}")
    say("[10] 1000000000 - 1 = {big_str(\"1000000000\") - big(1)}")

    say("===== 带符号 =====")
    m7 := big(-7)
    p2 := big(2)
    say("[11] -7 / 2 = {m7 / p2} 余 {m7 % p2}   期望 -3 余 -1")
    say("[12] 7 / -2 = {big(7) / big(-2)} 余 {big(7) % big(-2)}   期望 -3 余 1")
    say("[13] -7 / -2 = {m7 / big(-2)}   期望 3")
    say("[14] -7 + 7 = {m7 + big(7)}   期望 0")
    say("[15] 0 * -5 = {big(0) * big(-5)}   期望 0（不能出现 -0）")
    say("[16] 3 - 10 = {big(3) - big(10)}   期望 -7")

    say("===== 比较（只定义了 op_eq / op_lt）=====")
    x := big_str("100000000000000000000")
    y := big_str("100000000000000000001")
    say("[17] x == y = {x == y}   期望 0")
    say("[18] x != y = {x != y}   期望 1")
    say("[19] x <  y = {x < y}   期望 1")
    say("[20] x >  y = {x > y}   期望 0")
    say("[21] x <= x = {x <= x}   期望 1")
    say("[22] x >= y = {x >= y}   期望 0")
    say("[23] -x < x = {-x < x}   期望 1")

    say("===== 其它 =====")
    // gcd(fib(30), fib(20)) = fib(gcd(30,20)) = fib(10) = 55
    say("[24] gcd(fib(30), fib(20)) = {big_gcd(big_fib(30), big_fib(20))}   期望 55")
    say("[25] fib(100) = {big_fib(100)}")
    say("[26] sign(-5) = {big(-5).sign()}   sign(0) = {big(0).sign()}")
    say("[27] abs(-42) = {big(-42).abs()}")

    // 超出 int64 就饱和，不回绕
    say("[28] 30!.to_int() = {big_fact(30).to_int()}   期望 9223372036854775807")
    say("[29] (-5).to_int() = {big(-5).to_int()}   期望 -5")

    // 除法的商余关系：a = b*q + r
    p := big_str("1000000000000000000000000000007")
    q := big_str("999999937")
    qr := p.divmod(q)
    say("[30] p = q*d + r 成立: {qr.q * q + qr.r == p}   期望 1")

    // 幂的符号：(-2)^3 = -8, (-2)^4 = 16
    say("[31] (-2)^3 = {big(-2).pow(3)}   (-2)^4 = {big(-2).pow(4)}")
}
