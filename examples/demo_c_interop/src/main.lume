#[ffi_export]
fn calc_sum(n:int) -> int
    s:int = 0
    i:int = 1
    while i <= n
        s := s + i
        i := i + 1
    end
ret s

fn main() -> int
    callback:any = ffi_export_ptr("calc_sum", "i64(i64)")
ret c_matmul(128, callback)

# `build_mode = "jit"` uses this entry; JIT now materializes the same
# `ffi_export_ptr` callback as the interpreter.
fn entry() -> int
    callback:any = ffi_export_ptr("calc_sum", "i64(i64)")
ret c_matmul(128, callback)
