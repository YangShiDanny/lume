{
  "name": "lume-language",
  "displayName": "Lume Language",
  "description": "Syntax highlighting and language tools for Lume",
  "version": "0.1.0",
  "publisher": "lumec",
  "icon": "images/lume-icon.png",
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Programming Languages", "Themes"],
  "activationEvents": ["onLanguage:lume"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{
      "id": "lume",
      "aliases": ["Lume"],
      "extensions": [".lume"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "lume",
      "scopeName": "source.lume",
      "path": "./syntaxes/lume.tmLanguage.json"
    }],
    "snippets": [{
      "language": "lume",
      "path": "./snippets/lume.code-snippets.json"
    }],
    "themes": [
      {"label": "Lume Night", "uiTheme": "vs-dark", "path": "./themes/lume-dark.json"},
      {"label": "Lume Day", "uiTheme": "vs", "path": "./themes/lume-light.json"}
    ],
    "iconThemes": [
      {"id": "lume-icons", "label": "Lume Icons", "path": "./icons/lume-file-icons.json"}
    ],
    "commands": [
      {"command":"lume.runFile","title":"Lume: Run Current File"},
      {"command":"lume.checkFile","title":"Lume: Check Current File"},
      {"command":"lume.openRepl","title":"Lume: Open REPL"}
    ],
    "configuration": {
      "title": "Lume",
      "properties": {
        "lume.bootstrapPath": {
          "type": "string",
          "default": "",
          "description": "Path to lume-bootstrap. Overrides workspace detection."
        },
        "lume.replCommand": {
          "type": "string",
          "default": "lume",
          "description": "Command used by 'Lume: Open REPL'."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "@vscode/vsce": "^3.2.1"
  }
}
