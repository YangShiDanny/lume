    bs := par_sum(big, 1500)
    say("[9d] 1500 个 1 并行求和={bs}                      期望 1500（大于就说明边界重复执行）")

    // else 分支里的归约也必须落到 worker 的私有累加器
    branch_values := [1; 1500]
    branch_total := 0
    par for i in 0..1500 {
        if i % 2 == 0 {
            branch_total += branch_values[i]
        } else {
            branch_total += branch_values[i] * 2
        }
    }
    say("[9f] 条件归约={branch_total}                      期望 2250")

    // 9e. 循环体读只读外层标量：k 要按值传进 worker（以前生成编译不过的 C）
    yk := [1.0, 2.0, 3.0, 4.0]
    yo := [0.0, 0.0, 0.0, 0.0]
    scale_by(yk, yo, 3.0, 4)
    say("[9e] 只读标量 k=3.0: {yo[0]} {yo[1]} {yo[2]} {yo[3]}      期望 3.0 / 6.0 / 9.0 / 12.0")

    // 10. par for 元素级 + 数组参数 restrict
    src := [1, 2, 3, 4, 5]
    dst := [0, 0, 0, 0, 0]
    dbl(src, dst, 5)
    say("[10] {dst[0]} {dst[1]} {dst[2]} {dst[3]} {dst[4]}     期望 2 4 6 8 10")

    // 11. float 数组参数（restrict + 向量化提示）
    ya := [1.0, 2.0, 3.0]
    yb := [0.5, 0.5, 0.5]
    yc := [0.0, 0.0, 0.0]
    axpy(ya, yb, yc, 3)
    say("[11] {yc[0]} {yc[1]} {yc[2]}                          期望 2.500000 / 4.500000 / 6.500000")

    // 12. @precompute：编译期查表
    t0 := now()
    f30 := fib(30)
    t1 := now()
    say("[12] fib(30)={f30}   耗时 {t1 - t0} ns                期望 832040")

    // 13. @cache：第一次算，第二次直接命中
    t2 := now()
    c1 := csteps(100000)
    t3 := now()
    c2 := csteps(100000)
    t4 := now()
    say("[13] csteps(100000)={c1}   首次 {t3 - t2} ns")
    say("[13] 再次调用={c2}         命中 {t4 - t3} ns          期望值相同，耗时接近 0")

    // 14. 隐式长度参数：不传 n。total(xs) 和 total(1500个1) 都只给数组
    n1 := total(xs)
    n2 := total(big)
    say("[14] total(xs)={n1}  total(1500个1)={n2}              期望 55 / 1500")

    // 15. 数组字面量直接作实参（长度编译器自己数）
    n3 := total([10, 20, 30])
    say("[15] total([10,20,30])={n3}                           期望 60")

    // 15b. 数组参数后面跟标量参数：确认伴随参数没把参数顺序打乱
    fn1 := first_n(xs, 4)
    say("[15b] first_n(xs,4)={fn1}                              期望 1+2+3+4 = 10")

    // 16. 函数返回数组：r.len 可用，说明长度真的跟着数组回来了
    r := scaled(xs, 3)
    say("[16] scaled(xs,3) 长度={r.len} 前三项={r[0]} {r[1]} {r[2]}     期望 10 / 3 6 9")

    // 17. 返回的数组继续传给别的函数，长度照样自动补
    n4 := total(r)
    say("[17] total(scaled(xs,3))={n4}                         期望 165")

    // 18. 入参数组直接传出（不拷贝），长度也带回来
    p := passthru(xs)
    say("[18] passthru(xs).len={p.len}  total={total(p)}        期望 10 / 55")

    // 19. if 表达式：编译成 C 三元，clang 会优化成 cmov
    a1 := abs_if(-7)
    a2 := abs_if(7)
    k1 := clamp(15, 0, 10)
    k2 := clamp(-3, 0, 10)
    k3 := clamp(5, 0, 10)
    say("[19] abs_if(-7)={a1} abs_if(7)={a2} clamp(15)={k1} clamp(-3)={k2} clamp(5)={k3}")
    say("                                   期望 7 / 7 / 10 / 0 / 5")

    // 20. match 结构体解构：_tag 判断类型 + 按位置绑定字段
    ci := Circle(r: 2.0)
    re := Rect(w: 3.0, h: 4.0)
    say("[20] Circle 面积={ci.area()}  Rect 面积={re.area()}    期望 12.566370 / 12.000000")
    match ci {
        Circle(r) => say("[20] 解构 Circle(r)：r={r} 面积={3.14159265358979 * r * r}"),
        _ => say("[20] 没匹配上 —— 不对"),
    }
    match re {
        Rect(w, h) => say("[20] 解构 Rect(w,h)：w={w} h={h} 面积={w * h}"),
        _ => say("[20] 没匹配上 —— 不对"),
    }
    // tag 判断要真的有效：Circle 不该匹配 Rect 的臂
    match ci {
        Rect(w, h) => say("[20] Circle 匹配上了 Rect —— tag 判断失效！"),
        _ => say("[20] Circle 不匹配 Rect 臂（tag 判断生效）"),
    }

    // 21. 字符串操作
    sv := "hello world"
    say("[21] contains(\"ell\")={str_contains(sv, "ell")} contains(\"xyz\")={str_contains(sv, "xyz")}   期望 1 / 0")
    say("[21] starts_with(\"hel\")={str_starts_with(sv, "hel")} ends_with(\"rld\")={str_ends_with(sv, "rld")}  期望 1 / 1")
    say("[21] replace(\"world\",\"lume\")={str_replace(sv, "world", "lume")}  期望 hello lume")

    // 21b. str_split：返回字符串数组，长度自动跟上
    parts := str_split("a,bb,ccc", ",")
    say("[21b] split(\"a,bb,ccc\",\",\") 段数={parts.len} 内容={parts[0]}|{parts[1]}|{parts[2]}  期望 3 / a|bb|ccc")

    // 21c. 字符串比较必须是内容比较，不能是指针比较
    e1 := "hello"
    e2 := "hello"
    e3 := "world"
    say("[21c] \"hello\"==\"hello\": {e1 == e2}   \"hello\"==\"world\": {e1 == e3}  期望 1 / 0")

    // 21d. 大小比较：strcmp 字典序
    say("[21d] \"abc\" < \"abd\": {\"abc\" < \"abd\"}   \"b\" > \"a\": {\"b\" > \"a\"}  期望 1 / 1")

    // 22. 除零检查：整数除法走 lume_checked_div_i64 包装，
    //     正常结果不能变（abort 行为用单独探针测，不能进主套件）
    q1 := 100 / 4
    q2 := 100 % 7
    q3 := 17 / 5
    say("[22] 100/4={q1} 100%7={q2} 17/5={q3}     期望 25 / 2 / 3")
    generic_float_zero := maxv(1.5, 4.25) / 0
    say("[22b] 泛型浮点除零={generic_float_zero}     期望 inf")

    // 23. BigInt 前置：定长数组字段、重复初始化和不换行输出
    zeros := [0; 4]
    filled := [7; 4]
    fractions := [1.5; 3]
    byte_marks: [u8; 4] = [7; 4]
    byte_ones: [u8; 4] = [1; 4]
    flags := [true; 3]
    probe := LimbProbe(limbs: [6; 4])
    probe.limbs[0] = 42
    repeated_sum := total([7; 4])
    repeated_return := repeat_values()
    write("[23] zero={zeros[0]} len={zeros.len} nonzero={filled[0]}/{filled[3]} ")
    write("float={fractions[0]}/{fractions[2]} struct={probe.limbs[0]}/{probe.limbs[1]}")
    write(" byte={byte_marks[0]}/{byte_marks[3]} ones={byte_ones[0]}/{byte_ones[3]} ")
    write("flags={flags[0]}/{flags[2]}")
    write(" +continued")
    say(" sum={repeated_sum} return={repeated_return.len}/{repeated_return[2]}")
    say(" 期望 0 / 4 / 7/7 / 1.5/1.5 / 42/6 / 7/7 / 1/1 / true/true / 28 / 3/9")

    // 24. 默认参数 + 命名参数：c 省略时用默认值 10；命名参数按名字重排
    say("[24] add3(1,2)={add3(1, 2)} add3(1,2,3)={add3(1, 2, 3)}     期望 13 / 6")
    say("[24] add3(c:5,a:1,b:2)={add3(c: 5, a: 1, b: 2)} add3(b:2,a:1)={add3(b: 2, a: 1)}   期望 8 / 13")

    // 27. 函数级 fastmath 与默认严格函数并存
    fast_result := call_fast_dot(1.25, 3.0, 2.0)
    strict_result := strict_dot(1.25, 3.0, 2.0)
    say("[27] fast={fast_result} strict={strict_result}   期望都是 5.750000")

    // 25. 日志性能基准：计时包含显式 flush 的真实 stdout 写出
    log_start := now()
    say("[25] serial print 1..100:")
    for i in 1..=100 {
        say("{i}")
    }
    flush()
    log_elapsed := now() - log_start
    say("[25] flush elapsed={log_elapsed} ns")

    // 26. 超过串行阈值，确认并行 worker 的日志以完整行刷新；块顺序不保证
    write("[26] parallel worker logs (unordered): ")
    par for i in 0..1100 {
        if i % 128 == 0 {
            say("worker[{i}]")
        }
    }
    flush()
    say("[26] worker logging complete")

    say("===== 完成 =====")
}
