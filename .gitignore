target/
.lume_cache/

# lume 把生成的 C 和可执行文件写在 CWD（cli.rs::output_c_path 只用文件名，不带目录），
# 所以文件名 = 源文件 stem。这里按已知的源文件逐个忽略。
# 调试用的临时文件一律放 .workbuddy/scratch/，不要留在仓库根。
main.c
main
output.c
output
_precompute_*
# 测试源文件（tests_*.lume）在仓库根，它们的编译产物和源文件同名（不带后缀），
# 所以按前缀整体忽略，再用 ! 把 .lume 放回来。
# 两条都必须带前导 `/` 锚定仓库根：不锚定的话 `tests_*` 会连
# tests/golden/tests_file.out 这种文件一起吞掉。
# 也别写成 `tests*` —— 那会把整个 tests/ 目录和新测试源文件一起忽略。
/tests_*
!/tests_*.lume
print_1_100.c
print_1_100
*.exe

*.o
*.dylib
*.so
*.dll

.vscode/
!vscode-extension/.vscode/
!vscode-extension/.vscode/launch.json
vscode-extension/*.vsix
.idea/
*.swp
.DS_Store
Thumbs.db

# 本地工作区（memory + scratch 临时文件）
.workbuddy/

# 本机删除操作的回收站（这个分区的 rm 会把文件挪到 .Trash-0）
.Trash-0/

